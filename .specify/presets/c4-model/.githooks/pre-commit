#!/usr/bin/env bash
# Run tests and available linters before each commit. Enabled by scripts/setup-dev.sh,
# which sets core.hooksPath to this directory.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python=$(command -v python3 || command -v python || true)
if [ -z "$python" ]; then
  echo "pre-commit: Python 3 not found; cannot run tests/." >&2
  exit 1
fi

if ! out=$("$python" -B -m unittest discover -s tests 2>&1); then
  echo "$out" >&2
  echo "pre-commit: tests failed; commit stopped." >&2
  exit 1
fi

if command -v uvx >/dev/null 2>&1; then
  uvx ruff check .
  uvx bandit -c bandit.yml -r scripts tests
else
  echo "pre-commit: uvx not found; skipping Ruff and Bandit." >&2
fi

if command -v npx >/dev/null 2>&1; then
  npx -y markdownlint-cli2
else
  echo "pre-commit: npx not found; skipping Markdown lint." >&2
fi
